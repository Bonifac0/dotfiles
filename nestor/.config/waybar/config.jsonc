{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "hyprland/language",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5
    }
  },

  "clock": {
    "format": "  {:%H:%M    %d-%m-%Y}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/actions.sh btop"
  },

  "memory": {
    "interval": 2,
    "format": " {used:0.1f}G",
    "tooltip": true
  },

  "network": {
    "interval": 2,
    "interface": "wlan0",

    "format-wifi": " {bandwidthDownBits:>6}↓ {bandwidthUpBits:>6}↑",
    "format-ethernet": "󰈀 {bandwidthDownBits:>6}↓ {bandwidthUpBits:>6}↑",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰤮 Offline",

    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": " {essid}\nSignal: {signalStrength}%\n↓ {bandwidthDownBits}\n↑ {bandwidthUpBits}",
    "tooltip-format-ethernet": "󰈀 {ifname}",
    "tooltip-format-disconnected": "Disconnected",

    "on-click": "~/.config/waybar/scripts/actions.sh network",
    "max-length": 50
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",

    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },

    "tooltip": false,

    "on-click": "~/.config/waybar/scripts/actions.sh audio",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "hyprland/language": {
    "format": "{short}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/actions.sh layout"
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
